{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "*.ts",
    "scripts/seed.ts",
    "scripts/backup-db.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-bank/types/**/*.ts",
    ".next-bank/dev/types/**/*.ts",
    ".next-finance/types/**/*.ts",
    ".next-finance/dev/types/**/*.ts",
    ".next-pilot/types/**/*.ts",
    ".next-pilot/dev/types/**/*.ts",
    ".next-pilot-build/types/**/*.ts",
    ".next-pilot-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "mobile"
  ]
}
